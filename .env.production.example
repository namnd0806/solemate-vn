# ============================================================
# SoleMate VN – Production Environment Variables
# Set these in Vercel Dashboard → Project → Settings → Environment Variables
# ============================================================

# Supabase – Public (safe to expose to browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Supabase – Server-only (NEVER use NEXT_PUBLIC_ prefix)
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# JWT Secret – used for signing customer and admin session tokens
# Must be at least 32 characters. Generate with: openssl rand -base64 32
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars_here
